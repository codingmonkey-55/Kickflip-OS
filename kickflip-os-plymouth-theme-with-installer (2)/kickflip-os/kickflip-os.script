# Kickflip OS Plymouth theme
# Uses the supplied 1920x1080 PNG as the boot splash.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo = Image("kickflip-os-plymouth-1920x1080.png");

# Center the artwork on any display resolution.
logo_sprite = Sprite(logo);
logo_sprite.SetPosition(
    Window.GetWidth() / 2 - logo.GetWidth() / 2,
    Window.GetHeight() / 2 - logo.GetHeight() / 2,
    10000
);

# Keep the logo visible throughout boot.
fun refresh_logo() {
    logo_sprite.SetOpacity(1);
}

refresh_logo();

# Plymouth calls these hooks when the boot state changes.
fun PlymouthDisplayNormal() {
    refresh_logo();
}

fun PlymouthDisplayPassword() {
    refresh_logo();
}

fun PlymouthDisplayQuestion() {
    refresh_logo();
}

fun PlymouthDisplayMessage(text) {
    refresh_logo();
}

fun PlymouthDisplayNormal() {
    refresh_logo();
}

fun PlymouthDisplayBoot() {
    refresh_logo();
}
